{
	"appId": "de.bavarianone.kartenspiele",
	"appName": "Bayerische Kartenspiele",
	"webDir": "www",
	"bundledWebRuntime": false,
	"android": {
		"allowMixedContent": true,
		"captureInput": true,
		"webContentsDebuggingEnabled": true
	},
	"plugins": {
		"SplashScreen": {
			"launchShowDuration": 2000,
			"backgroundColor": "#2e7d32",
			"showSpinner": false
		},
		"LocalNotifications": {
			"smallIcon": "ic_stat_icon_config_sample",
			"iconColor": "#2e7d32"
		},
		"PushNotifications": {
			"presentationOptions": [
				"badge",
				"sound",
				"alert"
			]
		}
	}
}
