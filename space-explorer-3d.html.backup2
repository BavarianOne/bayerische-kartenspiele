634|  e.preventDefault();const cx=window.innerWidth/2,cy=window.innerHeight/2;
635|  state.touchCX=Math.max(-1,Math.min(1,(t.clientX-cx)/cx));
636|  state.touchCY=Math.max(-1,Math.min(1,(t.clientY-cy)/cy));
