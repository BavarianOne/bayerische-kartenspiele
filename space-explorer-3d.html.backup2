1|<!DOCTYPE html>
2|<html lang="de">
3|<head>
4|<meta charset="UTF-8">
5|<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
6|<title>🌌 Space Explorer 3D – Fliegen & Entdecken</title>
7|<meta name="apple-mobile-web-app-capable" content="yes">
8|<meta name="apple-mobile-web-app-status-bar-style" content="default">
9|<meta name="apple-mobile-web-app-title" content="Space Explorer">
10|<style>
11|*{margin:0;padding:0;box-sizing:border-box}
12|html,body{overflow:hidden;height:100%;background:#000;font-family:'Segoe UI',Tahoma,Geneva,Verdana,sans-serif;touch-action:none;-webkit-user-select:none;user-select:none;-webkit-tap-highlight-color:transparent}
13|canvas{display:block;width:100%;height:100%}
14|
15|/* HUD */
16|#hud{position:fixed;top:0;left:0;right:0;bottom:0;pointer-events:none;z-index:10}
17|#topBar{position:absolute;top:10px;left:10px;right:10px;display:flex;justify-content:space-between;align-items:flex-start;gap:8px}
18|#location{background:rgba(0,10,30,0.85);backdrop-filter:blur(8px);border:1px solid rgba(0,255,200,0.2);border-radius:10px;padding:6px 12px;color:#0fc;font-size:0.75rem;letter-spacing:0.05em;flex:1;min-width:0;overflow:hidden}
19|#location .name{font-weight:700;font-size:0.85rem;color:#fff;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
20|#location .hint{color:rgba(255,255,255,0.4);font-size:0.65rem;margin-top:2px}
21|#speedometer{background:rgba(0,10,30,0.85);backdrop-filter:blur(8px);border:1px solid rgba(255,200,0,0.2);border-radius:10px;padding:6px 10px;text-align:right;min-width:70px;flex-shrink:0}
22|#speedometer .val{font-size:1.1rem;font-weight:700;color:#fc0;font-variant-numeric:tabular-nums}
23|#speedometer .unit{font-size:0.6rem;color:rgba(255,200,0,0.5);text-transform:uppercase;letter-spacing:0.1em}
24|#speedometer .label{font-size:0.6rem;color:rgba(255,200,0,0.4);text-transform:uppercase}
25|
26|/* Minimap / Radar */
27|#minimap{position:absolute;top:10px;right:10px;width:140px;height:140px;background:rgba(0,8,20,0.85);backdrop-filter:blur(8px);border:2px solid rgba(0,255,200,0.15);border-radius:50%;overflow:hidden;pointer-events:none;z-index:11;display:none}
28|#minimap.show{display:block}
29|#minimap canvas{width:100%;height:100%;display:block}
30|#minimapLabel{position:absolute;top:10px;right:10px;color:rgba(0,255,200,0.25);font-size:0.5rem;letter-spacing:0.15em;text-transform:uppercase;z-index:12;pointer-events:none;display:none}
31|#minimapLabel.show{display:block}
32|
33|/* Help overlay */
34|#helpOverlay{position:absolute;bottom:50%;left:50%;transform:translate(-50%,50%);background:rgba(0,10,30,0.85);backdrop-filter:blur(8px);border:2px solid rgba(0,255,200,0.2);border-radius:14px;padding:16px 24px;text-align:center;transition:opacity 1.5s;pointer-events:none;z-index:15;max-width:310px}
35|#helpOverlay.hidden{opacity:0}
36|#helpOverlay .title{font-size:1.1rem;color:#0fc;font-weight:700;margin-bottom:6px}
37|#helpOverlay .hint{font-size:0.8rem;color:rgba(255,255,255,0.6);line-height:1.5}
38|#helpOverlay .arrow{font-size:2rem;display:block;margin:8px 0;animation:floatArrow 2s ease-in-out infinite}
39|@keyframes floatArrow{0%,100%{transform:translateY(0)}50%{transform:translateY(-10px)}}
40|
41|/* Planet Info Card */
42|#planetInfo{position:absolute;bottom:200px;left:50%;transform:translateX(-50%);max-width:320px;width:90vw;background:rgba(0,10,30,0.92);backdrop-filter:blur(12px);border:2px solid rgba(0,255,200,0.3);border-radius:16px;padding:16px;box-shadow:0 0 40px rgba(0,255,200,0.1);transition:all 0.5s cubic-bezier(0.34,1.56,0.64,1);opacity:0;pointer-events:none;transform:translateX(-50%) translateY(20px)}
43|#planetInfo.open{opacity:1;pointer-events:auto;transform:translateX(-50%) translateY(0)}
44|#planetInfo .title{font-size:1.2rem;font-weight:700;color:#0fc;margin-bottom:4px}
45|#planetInfo .sub{font-size:0.75rem;color:rgba(255,255,255,0.5);margin-bottom:8px}
46|#planetInfo .desc{font-size:0.85rem;color:rgba(255,255,255,0.8);line-height:1.4;margin-bottom:8px}
47|#planetInfo .stats{display:flex;flex-wrap:wrap;gap:4px}
48|#planetInfo .stat{background:rgba(0,255,200,0.1);border:1px solid rgba(0,255,200,0.15);border-radius:6px;padding:3px 8px;font-size:0.7rem;color:rgba(255,255,255,0.6)}
49|#planetInfo .stat span{color:#0fc;font-weight:600}
50|#planetInfo .close{position:absolute;top:8px;right:10px;background:none;border:none;color:rgba(255,255,255,0.3);font-size:1.2rem;cursor:pointer;pointer-events:auto}
51|#planetInfo .close:hover{color:#fff}
52|
53|/* Landing / Launch button */
54|#landBtn{position:absolute;bottom:100px;left:50%;transform:translateX(-50%);background:rgba(0,200,255,0.15);backdrop-filter:blur(8px);border:2px solid rgba(0,255,200,0.4);border-radius:14px;padding:14px 28px;color:#0fc;font-size:1.1rem;font-weight:700;letter-spacing:0.05em;pointer-events:auto;z-index:15;opacity:0;transition:all 0.4s;cursor:pointer;white-space:nowrap}
55|#landBtn.show{opacity:1}
56|#landBtn:active{transform:translateX(-50%) scale(0.95)}
57|#landBtn.land{background:rgba(0,255,100,0.15);border-color:#0f6;color:#0f6}
58|#landBtn.launch{background:rgba(255,200,0,0.15);border-color:#fc0;color:#fc0}
59|
60|/* Landing zone indicator */
61|#landingZone{position:absolute;pointer-events:none;z-index:9;border-radius:50%;border:2px dashed rgba(0,255,200,0.2);top:50%;left:50%;transform:translate(-50%,-50%);width:60px;height:60px;animation:pulseRing 1.5s ease-in-out infinite;display:none}
62|#landingZone.show{display:block}
63|#landingZone.pulse{animation:pulseRing 1s ease-in-out infinite}
64|@keyframes pulseRing{0%,100%{transform:translate(-50%,-50%) scale(1);opacity:0.6}50%{transform:translate(-50%,-50%) scale(1.3);opacity:0.2}}
65|
66|/* Boost + Brake Buttons */
67|#btnRow{position:fixed;bottom:24px;left:0;right:0;display:flex;justify-content:space-between;padding:0 16px;pointer-events:none;z-index:20}
68|#btnRow button{pointer-events:auto;border:none;border-radius:14px;font-size:0.85rem;font-weight:700;letter-spacing:0.05em;display:flex;flex-direction:column;align-items:center;justify-content:center;transition:all 0.12s}
69|#btnRow button:active{transform:scale(0.92)}
70|#brakeBtn{width:80px;height:80px;border-radius:50%;border:3px solid rgba(255,100,50,0.3);background:rgba(40,10,0,0.8);backdrop-filter:blur(6px);color:#f84;font-size:1.6rem}
71|#brakeBtn:active,#brakeBtn.active{background:rgba(255,80,20,0.3);border-color:#f84}
72|#boostBtn{width:80px;height:80px;border-radius:50%;border:3px solid rgba(0,255,200,0.3);background:rgba(0,20,40,0.8);backdrop-filter:blur(6px);color:#0fc;font-size:1.6rem}
73|#boostBtn:active,#boostBtn.active{background:rgba(0,255,200,0.2);border-color:#0fc;box-shadow:0 0 30px rgba(0,255,200,0.4)}
74|#btnLabels{position:fixed;bottom:6px;left:16px;right:16px;display:flex;justify-content:space-between;color:rgba(255,255,255,0.2);font-size:0.55rem;text-transform:uppercase;letter-spacing:0.1em;pointer-events:none;z-index:20}
75|#btnLabels .l{text-align:left}
76|#btnLabels .r{text-align:right}
77|
78|/* Touch indicator ring */
79|#touchRing{position:fixed;width:60px;height:60px;border:3px solid rgba(0,255,200,0.4);border-radius:50%;pointer-events:none;z-index:25;transform:translate(-50%,-50%);transition:opacity 0.3s;opacity:0}
80|#touchRing.show{opacity:1}
81|#touchRing .inner{position:absolute;top:50%;left:50%;width:12px;height:12px;background:rgba(0,255,200,0.6);border-radius:50%;transform:translate(-50%,-50%)}
82|
83|/* Prograde / Retrograde Markers */
84|#progradeMarker{position:absolute;width:18px;height:18px;border:2px solid rgba(0,255,100,0.8);border-radius:50%;pointer-events:none;z-index:8;transform:translate(-50%,-50%);display:none}
85|#progradeMarker::after{content:'';position:absolute;top:50%;left:50%;width:10px;height:10px;background:rgba(0,255,100,0.6);border-radius:50%;transform:translate(-50%,-50%)}
86|#progradeMarker.show{display:block}
87|#retrogradeMarker{position:absolute;width:20px;height:20px;pointer-events:none;z-index:8;transform:translate(-50%,-50%);display:none}
88|#retrogradeMarker::before{content:'✕';position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);font-size:16px;color:rgba(255,80,50,0.8);font-weight:700}
89|#retrogradeMarker.show{display:block}
90|
91|/* Relative velocity hint */
92|#relVelHint{position:absolute;top:68px;left:10px;background:rgba(0,10,30,0.85);backdrop-filter:blur(8px);border:1px solid rgba(0,255,200,0.15);border-radius:8px;padding:4px 10px;font-size:0.7rem;color:rgba(255,255,255,0.5);pointer-events:none;z-index:12;display:none;white-space:nowrap}
93|#relVelHint.show{display:block}
94|#relVelHint .val{color:#fc0;font-weight:600}
95|#relVelHint .icon{display:inline-block;width:8px;height:8px;border-radius:50%;margin-right:4px}
96|
97|/* Landing state overlay */
98|#landedUI{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);text-align:center;pointer-events:none;z-index:12;opacity:0;transition:opacity 0.5s}
99|#landedUI.show{opacity:1}
100|#landedUI .planetName{font-size:1.8rem;color:#0fc;font-weight:700}
101|#landedUI .sub{font-size:0.9rem;color:rgba(255,255,255,0.5);margin-top:6px}
102|#landedUI .launchHint{font-size:0.8rem;color:rgba(255,200,0,0.6);margin-top:10px}
103|
104|/* Surface exploration mode UI */
105|#surfaceUI{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);text-align:center;pointer-events:none;z-index:12;opacity:0;transition:opacity 0.5s}
106|#surfaceUI.show{opacity:1}
107|#surfaceUI .modeTitle{font-size:1.5rem;color:#0f6;font-weight:700;margin-bottom:10px}
108|#surfaceUI .hint{font-size:0.85rem;color:rgba(255,255,255,0.7);line-height:1.4}
109|
110|/* Surface mode toggle button */
111|#surfaceModeBtn{position:absolute;bottom:140px;left:50%;transform:translateX(-50%);background:rgba(0,200,100,0.15);backdrop-filter:blur(8px);border:2px solid rgba(0,255,100,0.4);border-radius:14px;padding:10px 20px;color:#0f6;font-size:0.95rem;font-weight:700;pointer-events:auto;z-index:15;opacity:0;transition:all 0.4s;cursor:pointer;white-space:nowrap}
112|#surfaceModeBtn.show{opacity:1}
113|#surfaceModeBtn:hover{background:rgba(0,255,100,0.25)}
114|
115|/* First-person toggle */
116|#fpBtn{position:absolute;bottom:180px;left:50%;transform:translateX(-50%);background:rgba(100,100,200,0.15);backdrop-filter:blur(8px);border:2px solid rgba(150,150,255,0.4);border-radius:14px;padding:10px 20px;color:#aaf;font-size:0.95rem;font-weight:700;pointer-events:auto;z-index:15;opacity:0;transition:all 0.4s;cursor:pointer;white-space:nowrap}
117|#fpBtn.show{opacity:1}
118|#fpBtn.active{background:rgba(150,150,255,0.25);border-color:rgba(200,200,255,0.6)}
119|
120|/* Sequence status overlay */
121|#seqStatus{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);background:rgba(0,10,30,0.9);backdrop-filter:blur(8px);border:2px solid rgba(0,255,200,0.3);border-radius:12px;padding:10px 22px;color:#0fc;font-size:1.1rem;font-weight:700;text-align:center;pointer-events:none;z-index:16;opacity:0;transition:opacity 0.3s;letter-spacing:0.05em}
122|#seqStatus.show{opacity:1}
123|
124|@media(max-width:768px){
125|  #boostBtn,#brakeBtn{width:70px;height:70px;font-size:1.3rem}
126|  #topBar{padding:6px}
127|  #location{font-size:0.7rem;padding:4px 10px}
128|  #speedometer{padding:4px 8px;min-width:60px}
129|  #speedometer .val{font-size:0.95rem}
130|  #minimap{width:100px;height:100px;top:6px;right:6px}
131|  #planetInfo{bottom:170px;padding:12px;max-width:280px}
132|  #helpOverlay{padding:12px 16px;max-width:260px}
133|  #helpOverlay .title{font-size:0.95rem}
134|  #helpOverlay .hint{font-size:0.75rem}
135|  #landedUI .planetName{font-size:1.4rem}
136|}
137|</style>
138|</head>
139|<body>
140|
141|<div id="hud">
142|  <div id="topBar">
143|    <div id="location">
144|      <div class="name" id="locName">🚀 Im All</div>
145|      <div class="hint" id="nearHint">–</div>
146|    </div>
147|    <div id="speedometer">
148|      <div class="label">Geschw.</div>
149|      <div class="val" id="speedVal">0</div>
150|      <div class="unit">km/s</div>
151|    </div>
152|  </div>
153|
154|  <div id="minimap" class="show"><canvas id="mapCanvas" width="140" height="140"></canvas></div>
155|  <div id="minimapLabel" class="show">RADAR</div>
156|
157|  <div id="progradeMarker"></div>
158|  <div id="retrogradeMarker"></div>
159|  <div id="relVelHint"></div>
160|
161|  <div id="helpOverlay">
162|  <div class="title">🚀 Space Explorer 3D</div>
163|  <div class="arrow">👆</div>
164|  <div class="hint">Finger auf Bildschirm & ziehen → fliegen<br>⛔ = Bremsen · ⚡ = Boost<br>🪐 Planet anfliegen & ⬇️ Landen drücken<br>🖱️ WASD + Maus · Shift=Boost · Space=Bremse<br><br>🌍 <strong>Auf Planeten:</strong><br>E = Oberflächenmodus · Enter = Starten<br>WASD = Bewegen · Space = Springen · Tab = Kamera<br>Maus = Schauen (First-Person)</div>
165|  </div>
166|
167|  <div id="landingZone"></div>
168|
169|  <div id="planetInfo">
170|    <button class="close" onclick="closePlanetInfo()">✕</button>
171|    <div class="title" id="piTitle">🌍 Planet</div>
172|    <div class="sub" id="piSub">–</div>
173|    <div class="desc" id="piDesc">–</div>
174|    <div class="stats" id="piStats"></div>
175|  </div>
176|
177|  <div id="seqStatus">⬇️ LANDUNG</div>
178|
179|  <div id="landedUI">
180|   <div class="planetName" id="landPlanetName">🪐 Planet</div>
181|   <div class="sub">Gelandet! 🛸</div>
182|   <div class="launchHint">👆 🚀 Starten (Enter) · 🚶 Erkunden (E)</div>
183|  </div>
184|
185|  <div id="surfaceUI">
186|   <div class="modeTitle">🌍 Oberflächenmodus</div>
187|   <div class="hint">WASD/Joystick: Bewegen · Space: Springen · Maus: Schauen · E: Zurück zum Schiff · Tab: Kamera wechseln</div>
188|  </div>
189|  </div>
190|
191|  <button id="landBtn" onclick="doLandOrLaunch()">⬇️ Landen</button>
192|
193|  <button id="surfaceModeBtn" onclick="toggleSurfaceMode()">🚶 Oberflächenmodus</button>
194|  <button id="fpBtn" onclick="toggleFirstPerson()">👁️ 1. Person</button>
195|
196|<div id="touchRing"><div class="inner"></div></div>
197|
198|<div id="btnRow">
199|  <button id="brakeBtn" ontouchstart="brakeDown=true;event.preventDefault()" ontouchend="brakeDown=false;event.preventDefault()" onmousedown="brakeDown=true" onmouseup="brakeDown=false">⛔</button>
200|  <button id="boostBtn" ontouchstart="boostDown=true;event.preventDefault()" ontouchend="boostDown=false;event.preventDefault()" onmousedown="boostDown=true" onmouseup="boostDown=false">⚡</button>
201|</div>
202|<div id="btnLabels"><span class="l">⛔ Bremsen (Space)</span><span class="r">⚡ Boost (Shift)</span></div>
203|
204|<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
205|<script>
206|// ===================== CONFIG =====================
207|const CFG = {
208| world: { asteroidCount: 200, starCount: 3000, nebulaCount: 8 },
209| player: { thrust: 18, boostMultiplier: 3, brakePower: 50,
210| maxSpeed: 45, maxBoostSpeed: 140,
211| turnSensitivity: 0.014, maxPitch: 1.5, damping: 0.985 },
212| camera: { fov: 70, near: 0.5, far: 5000, followSpeed: 0.07 },
213| landing: { approachSpeed: 12, autoLandSpeed: 4, planetLandDist: 1.2,
214| approachAltitude: 8, descentDuration: 3 },
215| minimap: { radius: 55, range: 800, updateInterval: 3 },
216| surface: {
217| terrainSegments: 128, terrainScale: 0.08, surfaceGravity: 9.8,
218| surfaceMoveSpeed: 5, surfaceTurnSpeed: 0.02, surfaceJumpForce: 8,
219| surfaceFriction: 0.95, firstPersonMode: true
220| }
221|};
222|
223|// ===================== STATE =====================
224|const state = {
225| pos: new THREE.Vector3(0, 8, 0),
226| vel: new THREE.Vector3(0, 0, -6),
227| yaw: 0, pitch: 0,
228| speed: 0,
229| landed: false, landedOn: null,
230| nearPlanet: null, nearDist: Infinity,
231| // Controls
232| touchId: -1, touchActive: false,
233| touchCX: 0, touchCY: 0,
234| boostDown: false, brakeDown: false,
235| frameCount: 0, mapFrame: 0,
236| camDist: 4,
237| autoApproach: false, approachTarget: null,
238| // 3D Landing sequence state machine
239| seqState: 0, // 0=idle, 1=approach, 2=descent, 3=flare/touchdown, 4=landed, 5=liftoff, 6=climb
240| seqPlanet: null,
241| seqTimer: 0,
242| seqStartPos: null,
243| seqLandingPos: null,
244| seqEndPos: null,
245| seqStartVel: null,
246| // Surface exploration state
247| surfaceMode: false, // true when exploring planet surface on foot
248| surfaceYaw: 0, surfacePitch: 0,
249| surfaceVelocity: new THREE.Vector3(0, 0, 0),
250| surfaceOnGround: true,
251| surfaceJumping: false,
252| surfaceJumpTimer: 0,
253| firstPerson: false // First-person camera mode on surface
254|};
255|
256|// ===================== THREE SETUP =====================
257|const scene = new THREE.Scene();
258|const camera = new THREE.PerspectiveCamera(CFG.camera.fov, window.innerWidth/window.innerHeight, CFG.camera.near, CFG.camera.far);
259|const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: false });
260|renderer.setSize(window.innerWidth, window.innerHeight);
261|renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
262|renderer.toneMapping = THREE.ACESFilmicToneMapping;
263|renderer.toneMappingExposure = 1.2;
264|document.body.prepend(renderer.domElement);
265|camera.position.set(0, 2, 6);
266|
267|// ===================== STARS =====================
268|const starGeom = new THREE.BufferGeometry();
269|const sp = new Float32Array(CFG.world.starCount * 3);
270|const sc = new Float32Array(CFG.world.starCount * 3);
271|for(let i=0; i<CFG.world.starCount; i++){
272|  const theta = Math.random()*Math.PI*2, phi = Math.acos(Math.random()*2-1), r = 800+Math.random()*4000;
273|  sp[i*3]=r*Math.sin(phi)*Math.cos(theta); sp[i*3+1]=r*Math.sin(phi)*Math.sin(theta); sp[i*3+2]=r*Math.cos(phi);
274|  const c = 0.6+Math.random()*0.4; sc[i*3]=c; sc[i*3+1]=c; sc[i*3+2]=0.7+Math.random()*0.3;
275|}
276|starGeom.setAttribute('position', new THREE.BufferAttribute(sp,3));
277|starGeom.setAttribute('color', new THREE.BufferAttribute(sc,3));
278|scene.add(new THREE.Points(starGeom, new THREE.PointsMaterial({size:0.5,sizeAttenuation:true,vertexColors:true,transparent:true,opacity:0.9,blending:THREE.AdditiveBlending,depthWrite:false})));
279|
280|// ===================== NEBULAE =====================
281|for(let n=0; n<CFG.world.nebulaCount; n++){
282|  const g=new THREE.BufferGeometry(), p=new Float32Array(600*3), c=new Float32Array(600*3);
283|  const hue=Math.random(),cx=(Math.random()-0.5)*2000,cy=(Math.random()-0.5)*2000,cz=(Math.random()-0.5)*2000,spread=200+Math.random()*400;
284|  for(let i=0; i<600; i++){
285|    p[i*3]=cx+(Math.random()-0.5)*spread;p[i*3+1]=cy+(Math.random()-0.5)*spread*0.5;p[i*3+2]=cz+(Math.random()-0.5)*spread;
286|    const rgb=new THREE.Color().setHSL(hue+(Math.random()-0.5)*0.2,0.6,0.12+Math.random()*0.12);
287|    c[i*3]=rgb.r;c[i*3+1]=rgb.g;c[i*3+2]=rgb.b;
288|  }
289|  g.setAttribute('position',new THREE.BufferAttribute(p,3));g.setAttribute('color',new THREE.BufferAttribute(c,3));
290|  scene.add(new THREE.Points(g,new THREE.PointsMaterial({size:6+Math.random()*12,sizeAttenuation:true,vertexColors:true,transparent:true,opacity:0.12,blending:THREE.AdditiveBlending,depthWrite:false})));
291|}
292|
293|// ===================== PLANETS =====================
294|const planets = [];
295|const planetData = [
296| { name:'Merkur', color:0xaaaaaa, size:8, dist:120, orbSpeed:0.008, desc:'Kleinster Planet, voller Krater. Tagsüber bis 430°C!', landColor:0x888888, terrainSeed: 12345, terrainScale: 0.12 },
297| { name:'Venus', color:0xe6b85c, size:10, dist:180, orbSpeed:0.005, desc:'Heißester Planet! Giftige Wolken aus Schwefelsäure.', landColor:0xc8a050, terrainSeed: 23456, terrainScale: 0.10 },
298| { name:'Erde', color:0x4488cc, size:12, dist:240, orbSpeed:0.003, desc:'Unser Zuhause! 71% Wasser, grüne Kontinente. 🌍', landColor:0x3366aa, terrainSeed: 34567, terrainScale: 0.10 },
