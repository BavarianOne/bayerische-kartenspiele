1357|    state.surfaceJumping = false;
1358|    } else {
1359|    state.pos.copy(newPos);
1360|    state.surfaceOnGround = false;
1361|    }
1362|    } else {
1363|    state.pos.copy(newPos);
1364|    state.surfaceOnGround = false;
1365|    }
1366| 
1367|    // Camera for surface mode
