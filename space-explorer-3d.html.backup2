557|// Dust particles for touchdown
558|const dustCount = 60;
559|const dustGeom = new THREE.BufferGeometry();
560|const dustPos = new Float32Array(dustCount * 3);
561|const dustVel = new Float32Array(dustCount * 3);
562|const dustLife = new Float32Array(dustCount);
563|for(let i=0;i<dustCount;i++){
564|  dustPos[i*3]=0; dustPos[i*3+1]=-100; dustPos[i*3+2]=0; // hidden off screen
565|  dustVel[i*3]=0; dustVel[i*3+1]=0; dustVel[i*3+2]=0;
566|  dustLife[i]=0;
567|}
568|dustGeom.setAttribute('position', new THREE.BufferAttribute(dustPos,3));
569|const dustMat = new THREE.PointsMaterial({color:0xccaa88,size:0.08,transparent:true,opacity:0.6,blending:THREE.AdditiveBlending,depthWrite:false});
570|const dustParticles = new THREE.Points(dustGeom,dustMat);
571|dustParticles.visible = false;
572|scene.add(dustParticles);
573|// Store for animation
574|const dustState = { positions: dustPos, velocities: dustVel, lifetimes: dustLife, count: dustCount, active: false };
575|
576|function emitDustBurst(worldPos, count=30){
577|  dustParticles.visible = true;
578|  dustParticles.position.copy(worldPos);
579|  const pos = dustState.positions;
580|  const vel = dustState.velocities;
581|  const life = dustState.lifetimes;
582|  for(let i=0; i<count && i<dustCount; i++){
583|    pos[i*3] = (Math.random()-0.5)*0.5;
584|    pos[i*3+1] = (Math.random()-0.5)*0.2;
585|    pos[i*3+2] = (Math.random()-0.5)*0.5;
586|    vel[i*3] = (Math.random()-0.5)*2;
587|    vel[i*3+1] = Math.random()*3+1;
588|    vel[i*3+2] = (Math.random()-0.5)*2;
589|    life[i] = 0.5 + Math.random()*0.8;
590|  }
591|  dustParticles.geometry.attributes.position.needsUpdate = true;
592|}
593|
594|function updateDust(delta){
595|  if(!dustParticles.visible) return;
596|  const pos = dustState.positions;
597|  const vel = dustState.velocities;
598|  const life = dustState.lifetimes;
599|  let anyAlive = false;
600|  for(let i=0; i<dustCount; i++){
601|    if(life[i] > 0){
602|      life[i] -= delta;
603|      pos[i*3] += vel[i*3]*delta;
604|      pos[i*3+1] += vel[i*3+1]*delta;
605|      pos[i*3+2] += vel[i*3+2]*delta;
606|      vel[i*3+1] -= 3*delta; // gravity
607|      if(life[i] > 0) anyAlive = true;
608|    }else{
609|      // Reset below ground
610|      if(!anyAlive && i === dustCount-1){
611|        pos[i*3] = 0; pos[i*3+1] = -100; pos[i*3+2] = 0;
612|      }
613|    }
614|  }
615|  dustParticles.geometry.attributes.position.needsUpdate = true;
616|  if(!anyAlive){
617|    dustParticles.visible = false;
618|    dustState.active = false;
619|  }
620|}
