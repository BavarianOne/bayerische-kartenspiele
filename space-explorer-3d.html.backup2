1581|// ===================== MINIMAP =====================
1582|function drawMinimap(){
1583|  const canvas=document.getElementById('mapCanvas');
1584|  const ctx=canvas.getContext('2d');
1585|  const R=CFG.minimap.radius, cx=70, cy=70, range=CFG.minimap.range;
1586|
1587|  ctx.clearRect(0,0,140,140);
1588|
1589|  // Background circle
1590|  ctx.beginPath(); ctx.arc(cx,cy,R,0,Math.PI*2);
1591|  ctx.fillStyle='rgba(0,20,40,0.3)'; ctx.fill();
1592|  ctx.strokeStyle='rgba(0,255,200,0.2)'; ctx.lineWidth=1.5; ctx.stroke();
1593|
1594|  // Range rings
1595|  [0.33,0.66].forEach(f=>{
1596|    ctx.beginPath(); ctx.arc(cx,cy,R*f,0,Math.PI*2);
1597|    ctx.strokeStyle='rgba(0,255,200,0.06)'; ctx.lineWidth=1; ctx.stroke();
1598|  });
1599|
1600|  // Crosshair
1601|  ctx.strokeStyle='rgba(0,255,200,0.05)'; ctx.lineWidth=0.5;
1602|  ctx.beginPath(); ctx.moveTo(cx-R,cy); ctx.lineTo(cx+R,cy); ctx.stroke();
1603|  ctx.beginPath(); ctx.moveTo(cx,cy-R); ctx.lineTo(cx,cy+R); ctx.stroke();
1604|
1605|  // Draw planets
1606|  planets.forEach(p=>{
1607|    const dx=p.group.position.x-state.pos.x;
1608|    const dz=p.group.position.z-state.pos.z;
1609|    const dist=Math.sqrt(dx*dx+dz*dz);
1610|    if(dist>range) return;
1611|    const scale=dist/range;
1612|    const px=cx+dx/range*R;
1613|    const py=cy+dz/range*R;
1614|    const size=Math.max(3,p.data.size*2);
1615|    ctx.beginPath(); ctx.arc(px,py,size,0,Math.PI*2);
1616|    const col=new THREE.Color(p.data.color);
1617|    ctx.fillStyle=`rgb(${col.r*255|0},${col.g*255|0},${col.b*255|0})`;
1618|    ctx.fill();
1619|    ctx.strokeStyle='rgba(0,255,200,0.4)'; ctx.lineWidth=1; ctx.stroke();
1620|    // Label
1621|    ctx.fillStyle='rgba(0,255,200,0.7)'; ctx.font='7px sans-serif'; ctx.textAlign='center';
1622|    ctx.fillText(p.data.name,px,py+size+9);
1623|  });
1624|
1625|  // Draw nearest asteroid (up to 3)
1626|  asteroids.sort((a,b)=>state.pos.distanceTo(a.position)-state.pos.distanceTo(b.position));
1627|  for(let i=0;i<3&&i<asteroids.length;i++){
1628|    const a=asteroids[i];const d=state.pos.distanceTo(a.position);
1629|    if(d>range) continue;
1630|    const dx=a.position.x-state.pos.x, dz=a.position.z-state.pos.z;
1631|    const px=cx+dx/range*R, py=cy+dz/range*R;
1632|    ctx.beginPath(); ctx.arc(px,py,1.5,0,Math.PI*2);
1633|    ctx.fillStyle='rgba(150,150,150,0.4)'; ctx.fill();
1634|  }
1635|
1636|  // Sun (always visible at edges)
1637|  const sdx=-state.pos.x, sdz=-state.pos.z, sdist=Math.sqrt(sdx*sdx+sdz*sdz);
1638|  if(sdist>range){
1639|    const angle=Math.atan2(sdz,sdx);
1640|    const px=cx+Math.cos(angle)*(R-5), py=cy+Math.sin(angle)*(R-5);
1641|    ctx.beginPath(); ctx.arc(px,py,4,0,Math.PI*2);
1642|    ctx.fillStyle='rgba(255,200,50,0.8)'; ctx.fill();
1643|    ctx.fillStyle='rgba(255,200,50,0.5)'; ctx.font='6px sans-serif'; ctx.textAlign='center';
1644|    ctx.fillText('☀️',px,py+12);
1645|  } else {
1646|    const px=cx+sdx/range*R, py=cy+sdz/range*R;
1647|    ctx.beginPath(); ctx.arc(px,py,6,0,Math.PI*2);
1648|    ctx.fillStyle='rgba(255,200,50,0.6)'; ctx.fill();
1649|  }
1650|
1651|  // Player ship (center)
1652|  ctx.beginPath(); ctx.arc(cx,cy,3,0,Math.PI*2);
1653|  ctx.fillStyle='#0fc'; ctx.fill();
1654|  ctx.strokeStyle='rgba(0,255,200,0.3)'; ctx.lineWidth=1; ctx.stroke();
1655|
1656|  // Direction indicator (triangle)
1657|  const dirAngle = -state.yaw;
1658|  ctx.save(); ctx.translate(cx,cy); ctx.rotate(dirAngle);
1659|  ctx.beginPath(); ctx.moveTo(0,-8); ctx.lineTo(-4,4); ctx.lineTo(4,4); ctx.closePath();
1660|  ctx.fillStyle='rgba(0,255,200,0.5)'; ctx.fill();
1661|  ctx.restore();
1662|
1663|  // Text: scale + north
1664|  ctx.fillStyle='rgba(0,255,200,0.15)'; ctx.font='6px sans-serif'; ctx.textAlign='center';
1665|  ctx.fillText(`${range}km`,cx,R-4);
1666|}
1667|
1668|// ===================== PLANET INFO =====================
1669|function showPlanetInfo(p){
1670|  const pi=document.getElementById('planetInfo');
1671|  document.getElementById('piTitle').textContent=`🪐 ${p.data.name}`;
1672|  document.getElementById('piSub').textContent=`Planet · ${(state.pos.distanceTo(p.group.position)).toFixed(0)} km entfernt`;
1673|  document.getElementById('piDesc').textContent=p.data.desc;
1674|  document.getElementById('piStats').innerHTML=`
1675|    <div class="stat">Größe: <span>${p.data.size.toFixed(1)}</span></div>
1676|    <div class="stat">Bahn: <span>${p.data.dist} AE</span></div>
1677|    <div class="stat">Geschw.: <span>${(p.orbSpeed*1000).toFixed(0)} km/s</span></div>`;
1678|  pi.classList.add('open');
1679|}
1680|function closePlanetInfo(){document.getElementById('planetInfo').classList.remove('open');}
1681|
1682|// ===================== RESIZE =====================
1683|window.addEventListener('resize',()=>{
1684|  camera.aspect=window.innerWidth/window.innerHeight;camera.updateProjectionMatrix();
1685|  renderer.setSize(window.innerWidth,window.innerHeight);
1686|});
1687|
1688|// ===================== GAME LOOP =====================
1689|let lastTime=0;
1690|function animate(time){
1691|  const delta=(time-lastTime)/1000;lastTime=time;
1692|  update(delta);renderer.render(scene,camera);
1693|  requestAnimationFrame(animate);
1694|}
1695|animate(0);
1696|
1697|// ===================== WAKE LOCK =====================
1698|if(navigator.wakeLock){let wl;
1699|  (async()=>{try{wl=await navigator.wakeLock.request('screen');}catch(e){}})();
1700|  document.addEventListener('visibilitychange',()=>{if(document.visibilityState==='visible'&&wl)wl.release().then(()=>{}).catch(()=>{});});
1701|}
1702|console.log('🚀 Space Explorer 3D – Fliegen, Landen, Planeten erkunden! [L]=Landen [Space]=Bremse [Shift]=Boost [E]=Oberflächenmodus [Tab]=Kamera wechseln');
1703|</script>
1704|</body>
1705|</html>