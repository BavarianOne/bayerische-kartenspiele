1283| 
1284|    // Get current position relative to planet center
1285|    const surfacePos = state.pos.clone();
1286|    const planetCenter = p.group.position.clone();
1287| 
1288|    // Surface movement controls
1289|    const moveSpeed = CFG.surface.surfaceMoveSpeed;
1290|    const forwardDir = new THREE.Vector3(
1291|    Math.sin(state.surfaceYaw) * Math.cos(state.surfacePitch),
1292|    Math.sin(state.surfacePitch),
1293|    Math.cos(state.surfaceYaw) * Math.cos(state.surfacePitch)
1294|    );
1295|    const rightDir = new THREE.Vector3(
1296|    Math.sin(state.surfaceYaw + Math.PI/2),
1297|    0,
1298|    Math.cos(state.surfaceYaw + Math.PI/2)
1299|    );
1300| 
1301|    // WASD movement
1302|    if(keys['w'] || keys['arrowup']) {
1303|    state.surfaceVelocity.add(forwardDir.clone().multiplyScalar(moveSpeed * delta));
1304|    }
1305|    if(keys['s'] || keys['arrowdown']) {
1306|    state.surfaceVelocity.add(forwardDir.clone().negate().multiplyScalar(moveSpeed * delta));
1307|    }
1308|    if(keys['a'] || keys['arrowleft']) {
1309|    state.surfaceVelocity.add(rightDir.clone().multiplyScalar(moveSpeed * delta));
1310|    }
1311|    if(keys['d'] || keys['arrowright']) {
1312|    state.surfaceVelocity.add(rightDir.clone().negate().multiplyScalar(moveSpeed * delta));
1313|    }
1314| 
