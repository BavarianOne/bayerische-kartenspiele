1316|    if((keys[' '] || keys['space']) && state.surfaceOnGround && !state.surfaceJumping) {
1317|    state.surfaceVelocity.y = CFG.surface.surfaceJumpForce;
1318|    state.surfaceOnGround = false;
1319|    state.surfaceJumping = true;
1320|    state.surfaceJumpTimer = 0;
1321|    }
1322| 
1323|    // Apply gravity
1324|    state.surfaceVelocity.y -= CFG.surface.surfaceGravity * delta;
1325| 
1326|    // Apply friction to horizontal movement
1327|    state.surfaceVelocity.x *= CFG.surface.surfaceFriction;
1328|    state.surfaceVelocity.z *= CFG.surface.surfaceFriction;
1329| 
1330|    // Update position
1331|    const newPos = surfacePos.clone().add(state.surfaceVelocity.clone().multiplyScalar(delta));
1332| 
1333|    // Raycast to find terrain height and normal at new position
1334|    const raycaster = new THREE.Raycaster();
1335|    const toPlanet = newPos.clone().sub(planetCenter).normalize();
1336|    const rayOrigin = newPos.clone().add(toPlanet.clone().multiplyScalar(10));
1337|    raycaster.set(rayOrigin, toPlanet.clone().negate());
1338| 
1339|    const intersects = raycaster.intersectObject(p.mesh, true);
1340|    let terrainNormal = new THREE.Vector3(0, 1, 0);
1341|    let onGround = false;
1342| 
1343|    if(intersects.length > 0) {
1344|    terrainNormal = intersects[0].face ? 
1345|    intersects[0].face.normal.clone().applyMatrix3(new THREE.Matrix3().getNormalMatrix(p.mesh.matrixWorld)) :
1346|    toPlanet.clone().negate();
1347| 
1348|    const hitDist = intersects[0].distance;
1349|    // Check if we're close enough to be on ground
