1534|// ===================== LANDING STATE =====================
1535|function detectLandingState(){
1536|  if(state.landed) return;
1537|  let nearest=null,nearDist=Infinity;
1538|  planets.forEach(p=>{const d=state.pos.distanceTo(p.group.position);if(d<nearDist){nearDist=d;nearest=p;}});
1539|  state.nearPlanet=nearest;state.nearDist=nearDist;
1540|
1541|  const landBtn=document.getElementById('landBtn');
1542|  const lz=document.getElementById('landingZone');
1543|
1544|  // Button immer zeigen, sobald ein Planet in Sichtweite (< 60 Einheiten)
1545|  if(nearest && nearDist < nearest.data.size + 60){
1546|    // PlanetInfo bei ausreichender Nähe
1547|    if(nearDist < nearest.data.size + 14) showPlanetInfo(nearest);
1548|
1549|    // Immer "Landen"-Button → startLandingSequence macht den Rest
1550|    landBtn.textContent=`⬇️ Landen (${nearest.data.name}) [L]`;
1551|    landBtn.className='show land';
1552|
1553|    // Lande-Zone-Fadenkreuz zeigen wenn nah genug
1554|    if(nearDist < nearest.data.size + 30){
1555|      const planetScreenPos = nearest.group.position.clone().project(camera);
1556|      const sx = (planetScreenPos.x*0.5+0.5)*window.innerWidth;
1557|      const sy = (-planetScreenPos.y*0.5+0.5)*window.innerHeight;
1558|      if(planetScreenPos.z<1){
1559|        lz.classList.add('show');
1560|        lz.style.left=sx+'px'; lz.style.top=sy+'px';
1561|      } else lz.classList.remove('show');
1562|    } else lz.classList.remove('show');
1563|
1564|    // Auto-Land wenn extrem nah & langsam
1565|    if(nearDist < nearest.data.size + 3.5 && state.speed < CFG.landing.autoLandSpeed && !state.touchActive){
1566|      startLandingSequence(nearest);
1567|      return;
1568|    }
1569|
1570|    document.getElementById('nearHint').textContent=`🪐 ${nearest.data.name} (${Math.round(nearDist)} km)`;
1571|    document.getElementById('locName').textContent=`🚀 ➔ ${nearest.data.name}`;
1572|  } else {
1573|    landBtn.classList.remove('show','land','launch');
1574|    lz.classList.remove('show');
1575|    document.getElementById('nearHint').textContent='–';
1576|    if(!state.landed) document.getElementById('locName').textContent='🚀 Im All';
1577|    closePlanetInfo();
1578|  }
1579|}
