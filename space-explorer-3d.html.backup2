303|
304|// Procedural noise function for terrain
305|function seededRandom(seed) {
306|  let x = Math.sin(seed) * 10000;
307|  return x - Math.floor(x);
308|}
309|
310|function noise2D(x, y, seed) {
311|  const nx = x * 0.1, ny = y * 0.1;
312|  const ix = Math.floor(nx), iy = Math.floor(ny);
313|  const fx = nx - ix, fy = ny - iy;
314|  
315|  const a = seededRandom(seed + ix * 12345 + iy * 67890);
316|  const b = seededRandom(seed + (ix+1) * 12345 + iy * 67890);
317|  const c = seededRandom(seed + ix * 12345 + (iy+1) * 67890);
318|  const d = seededRandom(seed + (ix+1) * 12345 + (iy+1) * 67890);
319|  
320|  const u = fx * fx * (3 - 2 * fx);
321|  const v = fy * fy * (3 - 2 * fy);
322|  
323|  return a * (1-u) * (1-v) + b * u * (1-v) + c * (1-u) * v + d * u * v;
324|}
325|
326|function fbm(x, y, seed, octaves=5) {
327|  let value = 0, amplitude = 1, frequency = 1, maxValue = 0;
328|  for(let i=0; i<octaves; i++) {
329|    value += amplitude * noise2D(x * frequency, y * frequency, seed + i * 1000);
330|    maxValue += amplitude;
331|    amplitude *= 0.5;
332|    frequency *= 2;
333|  }
334|  return value / maxValue;
335|}
336|
337| // Create terrain mesh with procedural displacement
338|function createPlanetTerrain(pd) {
339| const radius = pd.size;
340| const segments = 128; // Hohe Auflösung für detailliertes Terrain
341| const geom = new THREE.SphereGeometry(radius, segments, segments);
342| const positions = geom.attributes.position;
343|
344| // Store original positions for raycasting
345| const originalPositions = new Float32Array(positions.array.length);
346| originalPositions.set(positions.array);
347| geom.setAttribute('originalPosition', new THREE.BufferAttribute(originalPositions.slice(), 3));
348|
349| // Apply displacement mit mehr Details
350| for(let i=0; i<positions.count; i++) {
351| const x = positions.getX(i);
352| const y = positions.getY(i);
353| const z = positions.getZ(i);
354|
355| // Convert to spherical coordinates
356| const lat = Math.asin(y / radius);
357| const lon = Math.atan2(z, x);
358|
359| // Sample noise at this position mit mehr Octaves für Details
360| const h = fbm(lon * 15, lat * 15, pd.terrainSeed, 8);
361| const displacement = h * pd.size * pd.terrainScale;
362|
363| // Displace along normal
364| const len = Math.sqrt(x*x + y*y + z*z);
365| const nx = x / len, ny = y / len, nz = z / len;
366|
367| positions.setXYZ(i, x + nx * displacement, y + ny * displacement, z + nz * displacement);
368| }
369|
370| geom.computeVertexNormals();
371| geom.computeBoundingSphere();
372|  
373|  // Create material with terrain coloring based on height
374|  const terrainMaterial = new THREE.MeshPhongMaterial({
375|    color: pd.color,
376|    emissive: pd.color,
377|    emissiveIntensity: 0.05,
378|    shininess: 30,
379|    flatShading: true,
380|    vertexColors: true
381|  });
382|  
383|  // Add vertex colors based on height - verbessert für realistischere Oberfläche
384|  const colors = new Float32Array(positions.count * 3);
385|  const landColor = new THREE.Color(pd.landColor);
386|  const baseColor = new THREE.Color(pd.color);
387|  const mountainColor = new THREE.Color().setRGB(0.8, 0.8, 0.8); // Hell für Berge
388|  const valleyColor = new THREE.Color().setRGB(0.3, 0.3, 0.3); // Dunkel für Täler
389|
390|  for(let i=0; i<positions.count; i++) {
391|  const origX = originalPositions[i*3];
392|  const origY = originalPositions[i*3+1];
393|  const origZ = originalPositions[i*3+2];
394|  const newX = positions.getX(i);
395|  const newY = positions.getY(i);
396|  const newZ = positions.getZ(i);
397|
398|  const origLen = Math.sqrt(origX*origX + origY*origY + origZ*origZ);
399|  const newLen = Math.sqrt(newX*newX + newY*newY + newZ*newZ);
400|  const heightRatio = (newLen - origLen) / (pd.size * pd.terrainScale);
401|
402|  // Realistischere Farbverläufe basierend auf Höhe
403|  let r, g, b;
404|  if (heightRatio > 0.5) {
405|  // Sehr hohe Berge - fast weiß/hellgrau
406|  const mountainFactor = Math.min(1, (heightRatio - 0.5) * 2);
407|  r = THREE.MathUtils.lerp(landColor.r, mountainColor.r, mountainFactor);
408|  g = THREE.MathUtils.lerp(landColor.g, mountainColor.g, mountainFactor);
409|  b = THREE.MathUtils.lerp(landColor.b, mountainColor.b, mountainFactor);
410|  } else if (heightRatio > 0.1) {
411|  // Normale Hügel - Basislandfarbe
412|  r = landColor.r;
413|  g = landColor.g;
414|  b = landColor.b;
415|  } else if (heightRatio > -0.3) {
416|  // Flaches Land - leicht dunkler
417|  const flatFactor = 1 - Math.abs(heightRatio);
418|  r = landColor.r * (0.7 + flatFactor * 0.3);
419|  g = landColor.g * (0.7 + flatFactor * 0.3);
420|  b = landColor.b * (0.7 + flatFactor * 0.3);
421|  } else {
422|  // Täler/Krater - sehr dunkel
423|  const valleyFactor = Math.min(1, (-heightRatio - 0.3) * 2);
424|  r = THREE.MathUtils.lerp(landColor.r, valleyColor.r, valleyFactor);
425|  g = THREE.MathUtils.lerp(landColor.g, valleyColor.g, valleyFactor);
426|  b = THREE.MathUtils.lerp(landColor.b, valleyColor.b, valleyFactor);
427|  }
428|  colors[i*3] = r;
429|  colors[i*3+1] = g;
430|  colors[i*3+2] = b;
431|  }
432|  geom.setAttribute('color', new THREE.BufferAttribute(colors, 3));
433|  
434|  const mesh = new THREE.Mesh(geom, terrainMaterial);
435|  mesh.castShadow = true;
436|  mesh.receiveShadow = true;
437|  
438|  // Store terrain data for raycasting during landing
439|  mesh.userData.terrainData = {
440|    originalPositions: originalPositions,
441|    radius: radius,
442|    seed: pd.terrainSeed,
443|    scale: pd.terrainScale,
444|    landColor: pd.landColor
445|  };
446|  
447|  return mesh;
448|}
