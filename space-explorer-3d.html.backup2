760|// Raycast to find terrain height at a given position
761|function getTerrainHeight(planet, worldPos) {
762| const raycaster = new THREE.Raycaster();
763| const dir = planet.group.position.clone().sub(worldPos).normalize();
764| raycaster.set(worldPos, dir.negate());
765| 
766| const intersects = raycaster.intersectObject(planet.mesh, true);
767| if(intersects.length > 0) {
768| return intersects[0].distance;
769| }
770| return planet.data.size; // Fallback to base radius
771|}
772|
773|// Get terrain normal at a given position
774|function getTerrainNormal(planet, worldPos) {
775| const raycaster = new THREE.Raycaster();
776| const dir = planet.group.position.clone().sub(worldPos).normalize();
777| raycaster.set(worldPos, dir.negate());
778| 
779| const intersects = raycaster.intersectObject(planet.mesh, true);
780| if(intersects.length > 0 && intersects[0].face) {
781| return intersects[0].face.normal.clone().applyMatrix3(
782| new THREE.Matrix3().getNormalMatrix(planet.mesh.matrixWorld)
783| );
784| }
785| return new THREE.Vector3(0, 1, 0); // Fallback
786|}
