680|function doLandOrLaunch(){
681|  if(state.landed){ startLaunchSequence(); return; }
682|  if(state.seqState !== 0) return; // Bereits in Sequence
683|  if(state.autoApproach){
684|    cancelApproach();
685|    return;
686|  }
687|  let nearest=null,nearDist=Infinity;
688|  planets.forEach(p=>{const d=state.pos.distanceTo(p.group.position);if(d<nearDist){nearDist=d;nearest=p;}});
689|  if(!nearest) return;
690|  // Direkte Landesequenz starten, sobald nah genug (Größe + 40 Einheiten)
691|  startLandingSequence(nearest);
