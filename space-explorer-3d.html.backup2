729| const p = state.landedOn;
730| const terrainNormal = state.seqLandingNormal || new THREE.Vector3(0, 1, 0);
731| state.surfaceYaw = state.yaw;
732| state.surfacePitch = 0;
733| state.surfaceVelocity.set(0, 0, 0);
734| state.surfaceOnGround = true;
735| 
736| // Hide ship, show surface camera
