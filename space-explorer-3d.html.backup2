712|// ===================== SURFACE EXPLORATION FUNCTIONS =====================
713|function toggleSurfaceMode() {
714| if(!state.landed || !state.landedOn) return;
715| 
716| state.surfaceMode = !state.surfaceMode;
717| 
718| if(state.surfaceMode) {
719| // Enter surface exploration mode
720| state.firstPerson = false;
