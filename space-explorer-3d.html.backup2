788|// ===================== 3D LANDING SEQUENCE (WITH REAL TERRAIN) =====================
789|function startLandingSequence(planet){
790| if(!planet) return;
791| state.autoApproach = false;
792| state.approachTarget = null;
793|
794| document.getElementById('landBtn').classList.remove('show');
795| document.getElementById('locName').textContent=`🛸 Landung ${planet.data.name}`;
796| document.getElementById('seqStatus').textContent='⬇️ Sinkflug';
797| document.getElementById('seqStatus').className='show';
798|
799| // Raycast gegen echtes Terrain-Mesh für echte Landeposition
800| const terrainMesh = planet.mesh;
801| const raycaster = new THREE.Raycaster();
802| const dirFromShip = planet.group.position.clone().sub(state.pos).normalize();
803| const rayOrigin = state.pos.clone();
804| raycaster.set(rayOrigin, dirFromShip.negate()); // Ray from ship toward planet
805| 
806| const intersects = raycaster.intersectObject(terrainMesh, true);
807| let landingPos, landingNormal;
808|
809| if(intersects.length > 0) {
810| // Landung auf echter Terrain-Oberfläche
811| landingPos = intersects[0].point.clone();
812| landingNormal = intersects[0].face ? intersects[0].face.normal.clone().applyMatrix3(new THREE.Matrix3().getNormalMatrix(terrainMesh.matrixWorld)) : dirFromShip.clone();
813| } else {
814| // Fallback: Kugel-Oberfläche - EXAKT auf der Oberfläche (nicht darüber!)
815| landingPos = planet.group.position.clone().add(dirFromShip.clone().multiplyScalar(planet.data.size));
816| landingNormal = dirFromShip.clone();
817| }
818|
819| // STATE MACHINE auf Approach setzen (neue Phase 1 für Animation)
820| state.seqState = 1; // approach
821| state.seqPlanet = planet;
822| state.seqTimer = 0;
823| state.seqStartPos = state.pos.clone();
824| state.seqLandingPos = landingPos.clone();
825| state.seqLandingNormal = landingNormal.clone();
826|
827| // Schiff langsam abbremsen und ausrichten
828| state.pitch = 0.5;
829| const toPlanet = dirFromShip;
830| state.yaw = Math.atan2(toPlanet.x, toPlanet.z);
831|
832| // Ship rotation anpassen für bessere Landeanimation
833| shipGroup.rotation.set(state.pitch, state.yaw, 0);
834|}
835|
836|function updateLandingSequence(delta){
837| const p = state.seqPlanet;
838| if(!p) return;
839| state.seqTimer += delta;
840|
841| if(state.seqState === 1){
842| // ======= APPROACH: Langsames Annähern an den Planeten =======
843| const approachDuration = 2.0;
844| const t = Math.min(1, state.seqTimer / approachDuration);
845| const st = t * t; // ease-in für sanfte Annäherung
846|
847| // Zielposition: etwas über der Landezone (für bessere Animation)
848| const approachHeight = 5;
849| const approachTarget = state.seqLandingPos.clone().add(
850| state.seqLandingNormal.clone().multiplyScalar(approachHeight)
851| );
852|
853| // Schiff zur Approach-Position bewegen
854| state.pos.lerpVectors(state.seqStartPos, approachTarget, st);
855|
856| // Schiff ausrichten: Nase leicht nach oben, auf Planet zielen
857| state.pitch += (0.3 - state.pitch) * 0.05;
858| const toPlanet = p.group.position.clone().sub(state.pos).normalize();
859| state.yaw += (Math.atan2(toPlanet.x, toPlanet.z) - state.yaw) * 0.05;
860|
861| // Geschwindigkeit reduzieren
862| state.vel.multiplyScalar(0.95);
863| state.speed = state.vel.length();
864|
865| document.getElementById('seqStatus').textContent='🎯 Anflug';
866| document.getElementById('nearHint').textContent=`🛸 Anflug: ${Math.round((1-st)*100)}%`;
867|
868| if(t >= 1){
869| // Approach fertig, Descent starten
870| state.seqState = 2;
871| state.seqTimer = 0;
872| state.seqStartPos = state.pos.clone();
873| document.getElementById('seqStatus').textContent='⬇️ Sinkflug';
874| }
875| } else if(state.seqState === 2){
876| // ======= DESCENT: Sanfter Sinkflug auf ECHTER Terrain-Oberfläche =======
877| const duration = CFG.landing.descentDuration;
878| const t = Math.min(1, state.seqTimer / duration);
879| const st = t * t * (3 - 2 * t); // smoothstep
880|
881| // Verwende VORBERECHNETE echte Terrain-Landeposition und -Normale
882| const landingPos = state.seqLandingPos.clone();
883| const landingNormal = state.seqLandingNormal.clone();
884|
885| // Position interpolieren
886| state.pos.lerpVectors(state.seqStartPos, landingPos, st);
887|
888| // Ship-Orientierung: Nase nach oben, aber an Terrain-Normale angepasst
889| // Ziel: Schiff "steht" auf der Oberfläche (Up-Vektor = Terrain-Normale)
890| const targetUp = landingNormal.clone();
891| const targetForward = new THREE.Vector3(0, 0, -1).applyEuler(new THREE.Euler(state.pitch, state.yaw, 0, 'YXZ'));
892| 
893| // Pitch hochziehen (Nase zeigt nach oben) & langsam zurücknehmen für Flare
894| const pitchCurve = 1.0 - Math.min(0.8, t * t * 2.5);
895| state.pitch += (pitchCurve * 1.2 - state.pitch) * 0.08;
896|
897| // Yaw leicht an Terrain anpassen (für Seitwärts-Neigung bei Hängen)
898| state.yaw += Math.sin(state.seqTimer * 3) * 0.004;
899|
900| // Gear ausfahren bei ~50%
901|    if(st > 0.5 && !legGroup.visible){
902|      legGroup.visible = true;
903|      // Landing Gear an Terrain-Normale ausrichten
904|      legGroup.rotation.setFromQuaternion(new THREE.Quaternion().setFromUnitVectors(new THREE.Vector3(0,1,0), landingNormal));
905|      document.getElementById('seqStatus').textContent='🦿 Fahrwerk';
906|      setTimeout(()=>{document.getElementById('seqStatus').textContent='⬇️ Landen';},400);
907|    }
908|
909|    // Bei ~75% → Flare-Phase (Pitch flach + leicht absenken)
910|    if(st > 0.7){
911|      state.seqState = 3;
912|      state.seqTimer = 0;
913|      state.seqStartPos = state.pos.clone();
914|      document.getElementById('seqStatus').textContent='🔄 Abfangen';
915|    }
916|
917|    // Distanz-Info (echte Höhe über Terrain)
918|    const dist = state.pos.distanceTo(p.group.position);
919|    // Use getTerrainHeight for accurate height above actual terrain surface
920|    const currentTerrainHeight = getTerrainHeight(p, state.pos);
921|    const heightAboveTerrain = Math.max(0, dist - currentTerrainHeight);
922|    const heightM = Math.round(heightAboveTerrain * 1000);
    let hintText = `🛸 ${heightM} m`;
    if (state.seqState === 3 && heightM < 2000 && state.speed > 10) {
      hintText += ` ⚠️ LANGSAME! (${Math.round(state.speed)} km/s)`;
    }
    document.getElementById('nearHint').textContent = hintText;
923|  }
924|  else if(state.seqState === 3){
925|    // ======= FLARE + TOUCHDOWN auf ECHTEM Terrain =======
926|    const duration = 1.0;
927|    const t = Math.min(1, state.seqTimer / duration);
928|    const st = t * t * (3 - 2 * t);
929|
930|    // Verwende VORBERECHNETE echte Terrain-Position
931|    const landingPos = state.seqLandingPos.clone();
932|    const landingNormal = state.seqLandingNormal.clone();
933|
934|    state.pos.lerpVectors(state.seqStartPos, landingPos, st);
935|
936|    // Pitch nach unten zur Horizontalen (relativ zur Terrain-Normale)
937|    state.pitch *= 0.9;
938|    if(Math.abs(state.pitch) < 0.05) state.pitch = 0;
939|
940|    // Landing Gear an Terrain anpassen
941|    if(legGroup.visible) {
942|      legGroup.rotation.setFromQuaternion(new THREE.Quaternion().setFromUnitVectors(new THREE.Vector3(0,1,0), landingNormal));
943|    }
944|
945|    // Vibration kurz vor Touchdown
946|    if(st > 0.85){
947|    const vib = (1 - st) * 0.05;
948|    state.pos.x += (Math.random()-0.5) * vib;
949|    // state.pos.y += (Math.random()-0.5) * vib; // REMOVED: Keine Y-Vibration, sonst schwebt das Schiff!
950|    state.pos.z += (Math.random()-0.5) * vib;
951|    }
952|
953|    // Distanz-Info (echte Höhe über Terrain)
954|    const dist = state.pos.distanceTo(p.group.position);
955|    // Use getTerrainHeight for accurate height above actual terrain surface
956|    const currentTerrainHeight = getTerrainHeight(p, state.pos);
957|    const heightAboveTerrain = Math.max(0, dist - currentTerrainHeight);
958|    const heightM = Math.round(heightAboveTerrain * 1000);
    let hintText = `🛸 ${heightM} m`;
    if (state.seqState === 3 && heightM < 2000 && state.speed > 10) {
      hintText += ` ⚠️ LANGSAME! (${Math.round(state.speed)} km/s)`;
    }
    document.getElementById('nearHint').textContent = hintText;
959|
960|    // Touchdown!
961|    if(t >= 1){
962|    // NOCHMALS Raycast für EXAKTE Terrain-Position (Terrain könnte sich bewegt haben)
963|    const finalRaycaster = new THREE.Raycaster();
964|    const finalDir = p.group.position.clone().sub(state.pos).normalize();
965|    finalRaycaster.set(state.pos.clone(), finalDir.negate());
966|    const finalIntersects = finalRaycaster.intersectObject(p.mesh, true);
967| 
968|    let finalLandingPos = landingPos.clone();
969|    if(finalIntersects.length > 0) {
970|    finalLandingPos = finalIntersects[0].point.clone();
971|    } else {
972|    // Fallback: Berechne Position auf der Kugel-Oberfläche
973|    const distToCenter = state.pos.distanceTo(p.group.position);
974|    finalLandingPos = p.group.position.clone().add(
975|    finalDir.clone().multiplyScalar(Math.max(p.data.size, distToCenter))
976|    );
977|    }
978| 
979|    // Schiff EXAKT auf Terrain-Oberfläche setzen
980|    state.pos.copy(finalLandingPos);
981| 
982|    // WICHTIG: Schiff-Position relativ zum Planeten speichern für Oberflächenmodus
983|    state.seqLandingPos = finalLandingPos.clone();
984|    state.seqLandingNormal = finalIntersects.length > 0 && finalIntersects[0].face ?
985|    finalIntersects[0].face.normal.clone().applyMatrix3(new THREE.Matrix3().getNormalMatrix(p.mesh.matrixWorld)) :
986|    finalDir.clone();
987|
988|    state.vel.set(0,0,0);
989|    state.speed = 0;
990|
991|      // Landing-Gear fest an Terrain-Normale ausrichten
992|      legGroup.visible = true;
993|      legGroup.rotation.setFromQuaternion(new THREE.Quaternion().setFromUnitVectors(new THREE.Vector3(0,1,0), landingNormal));
994|
995|      // Dust an Touchdown-Position
996|      const dustWorldPos = landingPos.clone().add(landingNormal.clone().multiplyScalar(-0.1));
997|      emitDustBurst(dustWorldPos, 45);
998|
999|      // Landed setzen
1000|      state.seqState = 4;
1001|      state.landed = true;
1002|      state.landedOn = p;
1003|
1004|      // UI
1005|      document.getElementById('landBtn').textContent='🚀 Starten (Enter)';
1006|      document.getElementById('landBtn').className='show launch';
1007|      document.getElementById('locName').textContent=`🛸 ${p.data.name}`;
1008|      document.getElementById('landPlanetName').textContent=`🪐 ${p.data.name}`;
1009|      document.getElementById('landedUI').classList.add('show');
1010|      document.getElementById('landingZone').classList.remove('show');
1011|      document.getElementById('seqStatus').textContent='✅ Gelandet!';
1012|      document.getElementById('nearHint').textContent='–';
1013|      setTimeout(()=>{document.getElementById('seqStatus').className='';},2000);
1014|      closePlanetInfo();
1015|    }
1016|  }
1017|}
1018|
1019|// ===================== 3D LAUNCH SEQUENCE =====================
1020|function startLaunchSequence(){
1021|  if(!state.landed || !state.landedOn) return;
1022|
1023|  state.seqState = 7; // liftoff
1024|  state.seqPlanet = state.landedOn;
1025|  state.seqTimer = 0;
1026|  state.landed = false;
1027|
1028|  const p = state.landedOn;
1029|  state.seqStartPos = state.pos.clone();
1030|  state.landedOn = null;
1031|
1032|  // Endposition: etwas über der Oberfläche (entlang der Terrain-Normale), dann Wechsel zu Phase 6
1033|  // Verwende die gespeicherte Terrain-Normale vom Landepunkt
1034|  const upDir = state.seqLandingNormal.clone(); // Echte Terrain-Normale!
1035|  state.seqEndPos = p.group.position.clone().add(upDir.clone().multiplyScalar(p.data.size + CFG.landing.approachAltitude));
1036|
1037|  document.getElementById('landBtn').classList.remove('show','launch','land');
1038|  document.getElementById('landedUI').classList.remove('show');
1039|  document.getElementById('seqStatus').textContent='🚀 Start!';
1040|  document.getElementById('seqStatus').className='show';
1041|  document.getElementById('locName').textContent=`🚀 Start von ${p.data.name}`;
1042|
1043|  // Gear einfahren
1044|  legGroup.visible = false;
1045|
1046|  // Dust beim Abheben an Terrain-Position
1047|  const dustWorldPos = state.seqStartPos.clone().add(upDir.clone().multiplyScalar(-0.1));
1048|  emitDustBurst(dustWorldPos, 35);
1049|}
1050|
1051|function updateLaunchSequence(delta){
1052|  const p = state.seqPlanet;
1053|  if(!p) return;
1054|  state.seqTimer += delta;
1055|
1056|  if(state.seqState === 6){
1057|    // ======= LIFTOFF: Senkrechtstart aus der Atmosphäre =======
1058|    const duration = 2.0;
1059|    const t = Math.min(1, state.seqTimer / duration);
1060|    const st = t * t; // ease-in
1061|
1062|    // Nach oben fliegen
1063|    state.pos.lerpVectors(state.seqStartPos, state.seqEndPos, st);
1064|
1065|    // Pitch von 0 auf langsam schräg (fliegen weg)
1066|    if(t > 0.3){
1067|      state.pitch = (t - 0.3) * 0.4;
1068|    }
1069|
1070|    // Geschwindigkeit aufbauen
1071|    const upDir = state.pos.clone().sub(p.group.position).normalize();
1072|    state.vel.copy(upDir).multiplyScalar(8 + t * 20);
1073|
1074|    // Flamme
1075|    boostDown = true;
1076|
1077|    document.getElementById('nearHint').textContent=`🚀 ${Math.round((1-st)*100)}% Schub`;
1078|
1079|    if(t >= 1){
1080|      // Genug Abstand – in den Orbit fliegen
1081|      state.seqState = 7;
1082|      state.seqTimer = 0;
1083|      state.seqStartPos = state.pos.clone();
1084|      // Zielrichtung: weg vom Planeten, aber mit Kurve
1085|      const awayDir = state.pos.clone().sub(p.group.position).normalize();
1086|      state.vel.copy(awayDir).multiplyScalar(15);
1087|      document.getElementById('seqStatus').textContent='🚀 Orbit einnehmen';
1088|    }
1089|  }
1090|  else if(state.seqState === 7){
1091|    // ======= CLIMB: In den Orbit beschleunigen =======
1092|    const duration = 1.5;
1093|    const t = Math.min(1, state.seqTimer / duration);
1094|
1095|    // Weiter beschleunigen
1096|    const awayDir = state.pos.clone().sub(p.group.position).normalize();
1097|    state.vel.lerp(new THREE.Vector3(awayDir.x * 25, Math.abs(awayDir.y * 15) + 12, awayDir.z * 25), 0.05);
1098|    state.pos.add(state.vel.clone().multiplyScalar(delta));
1099|
1100|    // Pitch langsam nach vorne
1101|    state.pitch *= 0.95;
1102|    state.speed = state.vel.length();
1103|
1104|    if(t >= 1 && state.pos.distanceTo(p.group.position) > p.data.size + 20){
1105|      // Launch fertig
1106|      state.seqState = 0;
1107|      state.seqPlanet = null;
1108|      state.autoApproach = false;
1109|      state.approachTarget = null;
1110|      boostDown = false;
1111|      document.getElementById('seqStatus').className='';
1112|      document.getElementById('locName').textContent='🚀 Im All';
1113|      document.getElementById('nearHint').textContent='–';
1114|    }
1115|  }
1116|}
1117|
1118|// ===================== UPDATE =====================
1119|function update(delta){
1120|  state.frameCount++;
1121|  delta=Math.min(delta,0.05);
1122|
1123|  // ===== LANDING/LAUNCH SEQUENCE ACTIVE? =====
1124|  if(state.seqState >= 1 && state.seqState <= 3){
1125|    updateLandingSequence(delta);
1126|    updateDust(delta);
1127|    // Ship vis update
1128|    shipGroup.position.copy(state.pos);
1129|    shipGroup.rotation.set(state.pitch,state.yaw,0);
1130|    // Camera während Landing-Sequenz
1131|    if(state.seqState === 1){
1132|      // Während Approach: normale Chase-Cam
1133|      const targetDist=4;
1134|      state.camDist+=(targetDist-state.camDist)*0.08;
1135|      const horizontalOnly=new THREE.Vector3(0,state.camDist*0.4,state.camDist);
1136|      horizontalOnly.applyEuler(new THREE.Euler(0,state.yaw,0,'YXZ'));
1137|      const camPos=state.pos.clone().add(horizontalOnly);
1138|      camPos.y+=1.5+state.camDist*0.08;
1139|      camera.position.lerp(camPos,0.15);
1140|      const camLook=state.pos.clone().add(new THREE.Vector3(0,0,-1).applyEuler(new THREE.Euler(0,state.yaw,0,'YXZ')).multiplyScalar(3));
1141|      camera.lookAt(camLook);
1142|      } else if(state.seqState === 2) {
1143|      // Während Descent: Kamera nah an der Oberfläche für bessere 3D-Wirkung
1144|      const camOffset = new THREE.Vector3(0, 0.8, 2);
1145|      camOffset.applyEuler(new THREE.Euler(state.pitch, state.yaw, 0, 'YXZ'));
1146|      const camPos = state.pos.clone().add(camOffset);
1147|      camera.position.lerp(camPos, 0.15);
1148|      const lookTarget = state.pos.clone().add(new THREE.Vector3(0, 0, -3).applyEuler(new THREE.Euler(state.pitch, state.yaw, 0, 'YXZ')));
1149|      camera.lookAt(lookTarget);
1150|      } else if(state.seqState === 3) {
1151|      } else if(state.seqState === 3) {
1152|      // Während Flare/Touchdown: Sehr nah für dramatische Landung
1153|      const landingNormal = state.seqLandingNormal.clone();
1154|      const sideOffset = new THREE.Vector3(-landingNormal.z, 0, landingNormal.x).normalize().multiplyScalar(1.5);
1155|      const camPos = state.pos.clone().add(landingNormal.clone().multiplyScalar(1.2)).add(sideOffset);
1156|      camera.position.lerp(camPos, 0.2);
1157|      camera.lookAt(state.pos.clone().add(landingNormal.clone().multiplyScalar(0.1)));
1158|    }
1159|    // HUD
1160|    document.getElementById('speedVal').textContent=Math.round(state.speed*10)/10;
1161|    // Kein normales Update während Sequence
1162|    // (Planeten etc. weiterrotieren lassen)
1163|    planets.forEach((p,idx)=>{p.angle+=p.orbSpeed*delta*30;
1164|      p.group.position.x=p.dist*Math.cos(p.angle);p.group.position.z=p.dist*Math.sin(p.angle);
1165|      p.group.children[0].rotation.y+=delta*0.5;
1166|      if(p.group.children.length>1&&idx===5)p.group.children[1].rotation.z+=delta*0.3;
1167|    });
1168|    asteroids.forEach(a=>{a.rotation.x+=a.userData.rotSpeed.x;a.rotation.y+=a.userData.rotSpeed.y;a.rotation.z+=a.userData.rotSpeed.z;});
1169|    sun.rotation.y+=delta*0.1;
1170|    state.mapFrame++;
1171|    if(state.mapFrame%CFG.minimap.updateInterval===0) drawMinimap();
1172|    return; // Skip rest
1173|  }
1174|
1175|  // ===== LAUNCH SEQUENCE =====
1176|  if(state.seqState >= 5){
1177|    updateLaunchSequence(delta);
1178|    updateDust(delta);
1179|    shipGroup.position.copy(state.pos);
1180|    shipGroup.rotation.set(state.pitch,state.yaw,0);
1181|    // Camera
1182|    const camPos=state.pos.clone().add(new THREE.Vector3(0.5,1.5,3));
1183|    camera.position.lerp(camPos,0.15);
1184|    camera.lookAt(state.pos);
1185|    document.getElementById('speedVal').textContent=Math.round(state.speed*10)/10;
1186|    planets.forEach((p,idx)=>{p.angle+=p.orbSpeed*delta*30;
1187|      p.group.position.x=p.dist*Math.cos(p.angle);p.group.position.z=p.dist*Math.sin(p.angle);});
1188|    state.mapFrame++;
1189|    if(state.mapFrame%CFG.minimap.updateInterval===0) drawMinimap();
1190|    return;
1191|  }
1192|
1193|  if(!state.landed){
1194|    // ---------- AUTO-APPROACH (Autopilot) ----------
1195|    if(state.autoApproach&&state.approachTarget){
1196|      const target=state.approachTarget.group.position;
1197|      const toTarget=target.clone().sub(state.pos);
1198|      const dist=toTarget.length();
1199|      // Force-Land bei extremer Nähe (starte 3D-Landing)
1200|      if(dist<state.approachTarget.data.size+4){
1201|        const landTarget=state.approachTarget;
1202|        cancelApproach();
1203|        startLandingSequence(landTarget);
1204|        boostDown=false;brakeDown=false;
1205|        return;
1206|      }
1207|      // Ziel-Yaw und -Pitch berechnen
1208|      const targetYaw=-Math.atan2(toTarget.x,toTarget.z);
1209|      const targetPitch=-Math.atan2(toTarget.y,Math.sqrt(toTarget.x*toTarget.x+toTarget.z*toTarget.z));
1210|      // Smooth interpolieren (langsam für Kurskorrektur)
1211|      let dy=targetYaw-state.yaw; while(dy>Math.PI)dy-=Math.PI*2; while(dy<-Math.PI)dy+=Math.PI*2;
1212|      state.yaw+=dy*0.5*delta;
1213|      state.pitch+=(targetPitch-state.pitch)*0.3*delta;
1214|      state.pitch=Math.max(-CFG.player.maxPitch,Math.min(CFG.player.maxPitch,state.pitch));
1215|      // Speed anpassen: näher = langsamer
1216|      const wantSpeed=Math.min(40,Math.max(2,dist*0.1));
1217|      boostDown=state.speed<wantSpeed;
1218|      brakeDown=state.speed>wantSpeed+1;
1219|      // Distanz für HUD
1220|      const pct=dist/(state.approachTarget.data.size+25);
1221|      document.getElementById('nearHint').textContent=`🛰️ NAV: ${state.approachTarget.data.name} ⏎ ${Math.round(dist)} km ${pct<0.5?'🟢':'🟡'}`;
1222|      // Autopilot-Schub/Bremse anwenden
1223|      const forward=new THREE.Vector3(0,0,-1);
1224|      forward.applyEuler(new THREE.Euler(state.pitch,state.yaw,0,'YXZ'));
1225|      if(brakeDown){
1226|        state.vel.add(forward.clone().multiplyScalar(-CFG.player.brakePower*delta*2));
1227|        state.vel.multiplyScalar(0.9);
1228|      }else{
1229|        const thrust=CFG.player.thrust;
1230|        const maxSpd=Math.min(40,wantSpeed+3);
1231|        state.vel.add(forward.clone().multiplyScalar(thrust*delta));
1232|        state.vel.multiplyScalar(0.98);
1233|        if(state.vel.length()>maxSpd) state.vel.setLength(maxSpd);
1234|      }
1235|      state.pos.add(state.vel.clone().multiplyScalar(delta));
1236|      shipGroup.position.copy(state.pos);
1237|      shipGroup.rotation.set(state.pitch,state.yaw,0);
1238|      state.speed=state.vel.length();
1239|      // Automatisch Landung starten wenn nah genug & langsam genug
1240|      if(dist<state.approachTarget.data.size+25&&state.speed<CFG.landing.approachSpeed){
1241|        const landTarget=state.approachTarget;
1242|        cancelApproach();
1243|        startLandingSequence(landTarget);
1244|        boostDown=false;brakeDown=false;
1245|        return;
1246|      }
1247|    }else{
1248|      // Manual steering (Touch / WASD) - kein Autopilot
1249|      if(state.touchActive){
1250|        state.yaw-=state.touchCX*CFG.player.turnSensitivity*delta*60;
1251|        state.pitch=Math.max(-CFG.player.maxPitch,Math.min(CFG.player.maxPitch,
1252|          state.pitch+state.touchCY*CFG.player.turnSensitivity*delta*60));
1253|      }
1254|      if(keys['a']||keys['arrowleft']) state.yaw+=CFG.player.turnSensitivity*delta*50;
1255|      if(keys['d']||keys['arrowright']) state.yaw-=CFG.player.turnSensitivity*delta*50;
1256|      if(keys['w']||keys['arrowup']) state.pitch=Math.max(-CFG.player.maxPitch,state.pitch-CFG.player.turnSensitivity*delta*50);
1257|      if(keys['s']||keys['arrowdown']) state.pitch=Math.min(CFG.player.maxPitch,state.pitch+CFG.player.turnSensitivity*delta*50);
1258|
1259|      const boosting=boostDown,braking=brakeDown;
1260|      const forward=new THREE.Vector3(0,0,-1);
1261|      forward.applyEuler(new THREE.Euler(state.pitch,state.yaw,0,'YXZ'));
1262|      if(braking){
1263|        state.vel.add(forward.clone().multiplyScalar(-CFG.player.brakePower*delta));
1264|        state.vel.multiplyScalar(0.94);
1265|      }else{
1266|        const thrust=boosting?CFG.player.thrust*CFG.player.boostMultiplier:CFG.player.thrust;
1267|        const maxSpd=boosting?CFG.player.maxBoostSpeed:CFG.player.maxSpeed;
1268|        state.vel.add(forward.clone().multiplyScalar(thrust*delta));
1269|        state.vel.multiplyScalar(CFG.player.damping);
1270|        if(state.vel.length()>maxSpd) state.vel.setLength(maxSpd);
1271|      }
1272|      state.pos.add(state.vel.clone().multiplyScalar(delta));
1273|      shipGroup.position.copy(state.pos);
1274|      shipGroup.rotation.set(state.pitch,state.yaw,0);
